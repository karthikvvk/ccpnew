#### [NEW] [chunk_manager.py](file:///home/muruga/workspace/ccp_sem6/ccpmerging/ccpnew/modules/chunk_manager.py)
New module for chunk lifecycle management:

```python
class ChunkManager:
    """Manages chunk directories and status tracking"""
    
    def __init__(self, job_dir: Path):
        self.job_dir = job_dir
        self.chunks_dir = job_dir / 'chunks'
    
    def create_chunk(self, chunk_id: int) -> Path:
        """Create chunk directory structure"""
        # Returns: chunks/chunk_001/
        #   ├─ video.mp4
        #   ├─ audio.wav
        #   ├─ audio_subchunks/
        #   ├─ frames/
        #   ├─ stt.json
        #   ├─ translation.json
        #   ├─ tts.wav
        #   └─ status.json
    
    def get_chunk_status(self, chunk_id: int) -> dict:
        """Read status.json for a chunk"""
    
    def update_chunk_status(self, chunk_id: int, stage: str, success: bool, metadata: dict = None):
        """Update status.json with stage completion info"""
    
    def get_failed_chunks(self) -> List[int]:
        """Return list of chunk IDs that failed"""
    
    def get_pending_chunks(self) -> List[int]:
        """Return list of chunk IDs not yet processed"""
    
    def cleanup_chunks(self, keep_failed: bool = True):
        """Remove chunk artifacts after successful merge"""
```

