class TextDeduplicator:
    """Handles text overlap deduplication"""
    
    def merge_overlapping_segments(
        self, 
        segments: List[dict],
        overlap_tokens: int = 20,
        similarity_threshold: float = 0.85
    ) -> List[dict]:
        """
        Merge segments from overlapping audio sub-chunks.
        - Keeps earlier timestamp for duplicates
        - Uses token-level or embedding similarity
        """
    
    def compute_similarity(self, text1: str, text2: str) -> float:
        """Compute cosine similarity between text segments"""
    
    def align_timestamps(self, segments: List[dict], audio_offset: float) -> List[dict]:
        """Adjust segment timestamps by audio offset"""
```

