### services

#### [MODIFY] [pipeline.py](file:///home/muruga/workspace/ccp_sem6/ccpmerging/ccpnew/services/pipeline.py)
Major refactor:

```python
class TranslationPipeline:
    def process(self, video_path, target_language, source_language, use_rag):
        # 1. Get video info
        video_info = self.video_processor.get_video_info()
        duration = video_info['duration']
        
        # 2. Split video into chunks
        video_chunks = self.video_processor.split_video(
            video_path, 
            duration=settings.video_chunk_duration
        )
        
        # 3. Global RAG (video-level)
        if use_rag:
            global_context = self.extract_global_rag(video_path)
        
        # 4. Process each chunk
        chunk_results = []
        for i, chunk_path in enumerate(video_chunks):
            result = self.process_chunk(
                chunk_id=i,
                chunk_path=chunk_path,
                target_language=target_language,
                source_language=source_language,
                global_context=global_context,
                previous_context=chunk_results[-1] if chunk_results else None
            )
            chunk_results.append(result)
        
        # 5. Timeline-aware merge
        merged_audio = self.merge_chunk_audio(chunk_results)
        
        # 6. Reconstruct final video
        final_video = self.reconstruct_video(video_path, merged_audio)
        
        # 7. Validation
        self.validate_output(final_video, video_info)
        
        # 8. Safe cleanup
        if not settings.keep_temp_files:
            self.chunk_manager.cleanup_chunks()
        
        return result
    
    def process_chunk(self, chunk_id, chunk_path, target_language, source_language, 
                      global_context, previous_context):
        """
        Process a single video chunk through the full pipeline.
        - Idempotent: checks status.json before processing
        - Captures confidence scores
        - Passes context from previous chunk
        """
        chunk_dir = self.chunk_manager.create_chunk(chunk_id)
        
        # Check if already processed
        status = self.chunk_manager.get_chunk_status(chunk_id)
        if status.get('completed'):
            return self.load_chunk_result(chunk_id)
        
        try:
            # Extract audio
            audio_path = self.extract_chunk_audio(chunk_path, chunk_dir)
            
            # Split audio into sub-chunks
            audio_subchunks = self.video_processor.split_audio(
                audio_path,
                duration=settings.audio_subchunk_duration,
                overlap=settings.audio_overlap
            )
            
            # STT for each sub-chunk with context carryover
            all_segments = []
            context_prompt = previous_context.get('last_sentence') if previous_context else None
            
            for subchunk_path, start_time, end_time in audio_subchunks:
                result = self.stt.transcribe_with_confidence(
                    subchunk_path,
                    language=source_language,
                    context_prompt=context_prompt
                )
                # Adjust timestamps
                adjusted = self.text_dedup.align_timestamps(
                    result['segments'], 
                    audio_offset=start_time
                )
                all_segments.extend(adjusted)
                
                # Update context for next sub-chunk
                if adjusted:
                    context_prompt = adjusted[-1]['text']
            
            # Deduplicate overlapping segments
            merged_segments = self.text_dedup.merge_overlapping_segments(
                all_segments,
                overlap_tokens=settings.text_overlap_tokens,
                similarity_threshold=settings.dedup_similarity_threshold
            )
            
            # Local RAG (constrained by global)
            if global_context:
                local_context = self.rag.analyze_chunk(chunk_dir / 'frames', global_context)
            
            # Translation
            translated = self.translator.translate_segments(
                merged_segments,
                target_language,
                context=local_context
            )
            
            # TTS
            tts_audio = self.tts.segments_to_speech(translated, chunk_dir / 'tts.wav')
            
            # Update status
            self.chunk_manager.update_chunk_status(
                chunk_id, 
                stage='completed', 
                success=True,
                metadata={
                    'segments_count': len(merged_segments),
                    'last_sentence': merged_segments[-1]['text'] if merged_segments else None,
                    'tts_path': str(tts_audio)
                }
            )
            
            return {...}
            
        except Exception as e:
            self.chunk_manager.update_chunk_status(
                chunk_id, 
                stage='failed', 
                success=False,
                metadata={'error': str(e)}
            )
            raise
```

